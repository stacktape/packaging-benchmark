{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@bench/lib/*": [
        "./packages/lib/src/*"
      ]
    }
  },
  "include": [
    "src",
    "bin",
    "apps",
    "packages"
  ]
}
